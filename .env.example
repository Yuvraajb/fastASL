# Copy to .env and fill in. Every key is optional: features without a key show
# "Add <KEY> to .env" in the card and the rest of fastASL keeps working.

# Which LLM understands the signing (intent, spelling suggestions):
#   claude  the demo / submission setting (Anthropic track). Uses ANTHROPIC_API_KEY. Default when unset.
#   gemini  free testing on Google's free tier. Uses GEMINI_API_KEY and GEMINI_MODEL.
#   local   Ollama on this Mac, no key. Uses LOCAL_LLM_URL and LOCAL_LLM_MODEL.
#   mock    canned answers, no key and no network.
LLM_PROVIDER=claude

# Claude (intent understanding, spell completions)
ANTHROPIC_API_KEY=

# Gemini (LLM_PROVIDER=gemini). A free key comes from Google AI Studio.
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash-lite. gemini-3.8-flash is the bigger Flash model,
# but it did not answer on the free tier when this was written.
GEMINI_MODEL=

# Ollama (LLM_PROVIDER=local): install Ollama, then `ollama pull llama3.2`.
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2

# Factory Droid SDK (the agent that drives your Mac). Also needs the droid CLI:
# brew install --cask droid
FACTORY_API_KEY=

# Optional: absolute path to the droid CLI when it isn't found automatically
# (login shell PATH, ~/.local/bin, ~/.factory/bin, /opt/homebrew/bin, /usr/local/bin)
FACTORY_DROID_PATH=

# Spotify Web API (client credentials, used for search)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: the ESP32-CAM MJPEG stream offered in Settings › Camera source (option 2)
# until you type one there (option 3), e.g. http://192.168.1.50:81/stream
FASTASL_MJPEG_URL=
